    <ItemGroup>
      <PackageReference Include="Carter" Version="8.2.1" />
      <PackageReference Include="Marten" Version="8.22.0" />
      <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Scrutor" Version="7.0.0" />
      <PackageReference Include="StackExchange.Redis" Version="3.4.0" />
    </ItemGroup>

</Project>
